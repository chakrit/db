# Make-compatible defaults, not a shell script.
# Precedence: command line > .env.local > inherited environment > these defaults.
DB_DATA_ROOT     ?= $(DB_ROOT)/data
DB_CONFIG_ROOT   ?= $(DB_ROOT)/config
DB_WAIT_ATTEMPTS ?= 10

# Client-facing ports must be assigned by the control agent (8000–9000).
# MariaDB with no port runs on its local Unix socket only.
# Supply personal credentials through .env.local or the environment.

# PostgreSQL
PG_PORT     ?=
PG_PASSWORD ?=

# MariaDB (optional TCP listener and remote development account)
MARIADB_PORT            ?=
MARIADB_REMOTE_PASSWORD ?=

# Redis
REDIS_PORT     ?=
REDIS_PASSWORD ?=

# MailCatcher
MAILCATCHER_SMTP_PORT ?=
MAILCATCHER_HTTP_PORT ?=

# Typesense
TYPESENSE_PORT         ?=
TYPESENSE_PEERING_PORT ?=
TYPESENSE_API_KEY      ?=

# Garage generates private local credentials during init.
GARAGE_PORT     ?=
GARAGE_RPC_PORT ?=

# RabbitMQ
RABBITMQ_PORT      ?=
RABBITMQ_DIST_PORT ?=
RABBITMQ_PASSWORD  ?=
